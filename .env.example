# Copy this file to .env.local and fill it in. Never share or commit .env.local.

# Stripe secret key. Use a test key (sk_test_...) while setting up,
# and switch to your live key (sk_live_...) when the shop opens.
STRIPE_SECRET_KEY=

# The shop's public address once it's online, for example https://www.yourshop.com
# Leave empty while running on your computer.
NEXT_PUBLIC_SITE_URL=

# Set to true after you turn on Stripe Tax in the Stripe Dashboard.
STRIPE_AUTOMATIC_TAX=false

# Lets the shop trust messages from Stripe about paid orders, so it can lower stock.
# Starts with whsec_. See "Put it online" in the README, or "Try stock counting on your computer".
STRIPE_WEBHOOK_SECRET=

# Upstash Redis, where live stock counts are kept. On Vercel, connecting Upstash Redis under
# Storage fills these in for you. Leave them empty on your computer to keep counts in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
